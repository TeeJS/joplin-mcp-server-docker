# Joplin Web Clipper API token (Joplin Desktop -> Tools -> Options -> Web Clipper)
JOPLIN_TOKEN=replace_with_your_token

# IP or hostname of the machine running Joplin Desktop, reachable from the container.
# On Unraid, this is your PC's LAN IP (e.g. 192.168.1.50).
JOPLIN_HOST=192.168.1.50
JOPLIN_PORT=41184

# --- Tool exposure policy ---------------------------------------------------
# These limit what any caller can do, before any question of who they are.

# Disable every write tool (create/update/delete/tag/import). Leaves only
# search_notes, get_note, list_tags, get_note_tags. Set this whenever the
# endpoint is reachable by anyone you would not hand your notes to.
JOPLIN_READ_ONLY=false

# Directory `import_markdown` may read from. Unset (the default) removes the
# tool entirely. Leave it unset unless you have actually mounted a folder to
# import from: unconfined, the tool reads any file the container can see,
# including /proc/self/environ, which holds JOPLIN_TOKEN.
JOPLIN_IMPORT_ROOT=

# Allow delete_note(permanent=true), which bypasses the Joplin trash and cannot
# be undone. Off by default; a permanent delete is refused, not downgraded.
JOPLIN_ALLOW_PERMANENT_DELETE=false

# --- OAuth 2.1 --------------------------------------------------------------
# Off by default, so the same image runs unauthenticated on a trusted LAN and
# gated on a public hostname. Turn this on before the endpoint is reachable from
# the internet: without it, anyone who finds the URL has full use of the Joplin
# token above.

MCP_OAUTH_ENABLED=false

# Must equal what your provider reports in its discovery document, byte for
# byte. Check rather than assume — Authelia reports a bare origin, Authentik
# reports a path with a trailing slash:
#   curl -s https://auth.example.com/.well-known/openid-configuration | jq -r .issuer
MCP_OAUTH_ISSUER=

# Public base URL this server is reached on, no path. The connector URL — and
# therefore the `resource` value clients check — is this plus MCP_PATH.
MCP_SERVER_URL=

# Path the MCP endpoint is served on.
MCP_PATH=/mcp

# Expected "aud" claim. Leave empty until the flow works end to end: an audience
# mismatch produces a blanket 401 that looks like every other failure.
MCP_OAUTH_AUDIENCE=

# Seconds to cache provider discovery before re-fetching.
MCP_OAUTH_JWKS_CACHE_TTL=3600

# --- Group-based tool access ------------------------------------------------
# Both empty = no group checking; any valid token gets whatever the tool policy
# above already allows. Setting either one turns checking on, and a caller in
# neither list is refused with 403.
#
# Group policy only narrows. It cannot grant writes when JOPLIN_READ_ONLY=true.

MCP_OAUTH_GROUPS_CLAIM=groups
MCP_READ_GROUPS=
MCP_WRITE_GROUPS=
